{
  "identifier": "desktop-capability",
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "autostart:default",
    "notification:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-set-skip-taskbar"
  ]
}