{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-cap",
  "description": "enables http requests",
  "windows": ["main"],
  "permissions": [
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://claude.ai/*" },
        { "url": "https://api.claude.ai/*" }
      ]
    }
  ]
}
